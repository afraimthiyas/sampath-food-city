{
  "family": "sampath-food-city-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::063570950952:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::063570950952:role/sampath-food-city-task-role",
  "containerDefinitions": [
    {
      "name": "sampath-food-city-api",
      "image": "063570950952.dkr.ecr.us-east-1.amazonaws.com/sampath-food-city:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 3000, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "PORT", "value": "3000" },
        { "name": "DB_SYNCHRONIZE", "value": "false" },
        { "name": "DB_SSL", "value": "true" }
      ],
      "secrets": [
        { "name": "DB_HOST", "valueFrom": "arn:aws:secretsmanager:us-east-1:063570950952:secret:sampath-food-city/db:host::" },
        { "name": "DB_PORT", "valueFrom": "arn:aws:secretsmanager:us-east-1:063570950952:secret:sampath-food-city/db:port::" },
        { "name": "DB_USERNAME", "valueFrom": "arn:aws:secretsmanager:us-east-1:063570950952:secret:sampath-food-city/db:username::" },
        { "name": "DB_PASSWORD", "valueFrom": "arn:aws:secretsmanager:us-east-1:063570950952:secret:sampath-food-city/db:password::" },
        { "name": "DB_NAME", "valueFrom": "arn:aws:secretsmanager:us-east-1:063570950952:secret:sampath-food-city/db:dbname::" },
        { "name": "JWT_SECRET", "valueFrom": "arn:aws:secretsmanager:us-east-1:063570950952:secret:sampath-food-city/jwt:JWT_SECRET::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/sampath-food-city",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "api"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "node -e \"require('http').get('http://localhost:3000/health', r => process.exit(r.statusCode===200?0:1)).on('error', () => process.exit(1))\""],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      }
    }
  ]
}